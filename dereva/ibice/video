        // ============================================
        // DOWNLOAD VIDEO
        // ============================================
        window.mayeDownloadVideo = function(url, filename) {
            const notification = document.getElementById('mayeDownloadNotification');
            const notificationText = document.getElementById('mayeDownloadNotificationText');
            
            if (notification && notificationText) {
                notificationText.textContent = `Download itangira: ${filename}`;
                notification.classList.add('maye-show');
            }
            
            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.blob();
                })
                .then(blob => {
                    const blobUrl = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = blobUrl;
                    link.download = filename;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(blobUrl);
                    
                    if (notificationText) {
                        notificationText.textContent = `✅ ${filename} yakuwe neza!`;
                    }
                    
                    setTimeout(() => {
                        if (notification) notification.classList.remove('maye-show');
                    }, 3000);
                })
                .catch(error => {
                    console.error('Download error:', error);
                    if (notificationText) {
                        notificationText.textContent = '⚠️ Download yananiwe. Kanda "Full Screen".';
                    }
                    
                    setTimeout(() => {
                        window.open(url, '_blank');
                        if (notification) notification.classList.remove('maye-show');
                    }, 1500);
                });
