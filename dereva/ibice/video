            console.log('🎬 Opening video popup:', videoId);
            
            const video = window.mayeVideosData.find(v => v.id === videoId);
            if (!video) return;
            
            const overlay = document.getElementById('mayeVideoPopupOverlay');
            const player = document.getElementById('mayeVideoPopupPlayer');
            const numberBadge = document.getElementById('mayeVideoPopupNumberBadge');
            const titleText = document.getElementById('mayeVideoPopupTitleText');
            const summaryText = document.getElementById('mayeVideoPopupSummaryText');
            const downloadBtn = document.getElementById('mayeVideoPopupDownloadBtn');
            const fullScreenBtn = document.getElementById('mayeVideoPopupFullScreenBtn');
            
            if (!overlay || !player) return;
            
            // Set video source
            player.src = video.url;
            player.load();
            
            // Update UI
            if (numberBadge) numberBadge.textContent = video.id;
            if (titleText) titleText.textContent = video.title;
            if (summaryText) summaryText.textContent = video.summary;
            if (fullScreenBtn) fullScreenBtn.href = video.url;
            
            // Set download handler
            if (downloadBtn) {
                downloadBtn.onclick = function() {
                    window.mayeDownloadVideo(video.url, `Amategeko-Video-${video.id}.mp4`);
                };
            }
            
            // Show overlay
            overlay.style.display = 'flex';
            overlay.classList.add('maye-active');
            
            // Prevent body scroll
            document.body.style.overflow = 'hidden';
            
            // Auto play
            setTimeout(() => {
                player.play().catch(err => console.log('Autoplay prevented:', err));
